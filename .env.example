# Copy to .env in the project root. Fill in the keys for the services you use.
# .env is ignored by Git. Environment variables take precedence.
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Set product subscription keys, or set OAG_API_KEY if one key covers all products.
OAG_MASTER_DATA_API_KEY=
OAG_FLIGHT_INFO_API_KEY=
OAG_CONNECTIONS_API_KEY=
OAG_API_KEY=

# Optional voice settings
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# SKYASSIST_VOICE_MAX_SECONDS=45
# SKYASSIST_VOICE_MAX_STREAMS=6

# Map landmark for the kiosk's initial position
# SKYASSIST_KIOSK_NODE=c22
